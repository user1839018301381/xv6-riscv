---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import 'katex/dist/katex.min.css';
import '../../tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = 'A local reader for MIT 6.1810 Labs and the xv6 book.', lang = 'en' } = Astro.props;
const pageTitle = title === 'xv6 Reader' ? title : `${title} · xv6 Reader`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="description" content={description}>
    <meta name="color-scheme" content="light dark">
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('xv6-reader-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <script is:inline src="/reader.js"></script>
  </body>
</html>
