---
import { getCollection } from 'astro:content';
import BookFrame from '../../components/BookFrame.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { chapterPath, sectionPath } from '../../../scripts/lib/config.ts';
import { bookToc, linkBookSections, splitBookChapter } from '../../../scripts/lib/book-sections.ts';

export async function getStaticPaths() {
  const entries = (await getCollection('bookJa')).sort((a, b) => a.data.chapter - b.data.chapter);
  const chapters = linkBookSections(entries.map(splitBookChapter));
  const toc = bookToc(chapters);
  return entries.map((entry, index) => ({
    params: { chapter: `chapter-${entry.data.chapter}` },
    props: { entry, chapter: chapters[index], toc, previousChapter: chapters[index - 1], nextChapter: chapters[index + 1] }
  }));
}

const { entry, chapter, toc, previousChapter, nextChapter } = Astro.props;
const firstSection = chapter.sections[1];
const next = firstSection
  ? { href: sectionPath(chapter.chapter, firstSection.number), label: `${chapter.chapter}.${firstSection.number} ${firstSection.title}` }
  : nextChapter && { href: chapterPath(nextChapter.chapter), label: `第${nextChapter.chapter}章 ${nextChapter.title}` };
---

<BaseLayout title={entry.data.title} description={`xv6 book 第${chapter.chapter}章`} lang="ja" bookStyle>
  <BookFrame chapters={toc} currentChapter={chapter.chapter} previous={previousChapter && { href: chapterPath(previousChapter.chapter), label: `第${previousChapter.chapter}章 ${previousChapter.title}` }} next={next}>
    <article class="book-reader">
    <header class="book-heading">
      <p>{chapter.chapter === 0 ? '序文' : `Chapter ${chapter.chapter}`}</p>
      <h1>{chapter.title}</h1>
    </header>

    <div class="prose book-prose" set:html={chapter.sections[0].html} />

    {firstSection && (
      <nav class="book-section-list" aria-label="この章の節">
        <h2>この章の内容</h2>
        <ol>
          {chapter.sections.slice(1).map((section) => (
            <li><a href={sectionPath(chapter.chapter, section.number)}><span>{chapter.chapter}.{section.number}</span><span>{section.title}</span></a></li>
          ))}
        </ol>
      </nav>
    )}

    <p class="book-source"><a href={`https://github.com/mit-pdos/xv6-riscv-book/tree/${entry.data.commit}`}>原典: xv6-riscv-book</a></p>
    </article>
  </BookFrame>
</BaseLayout>
