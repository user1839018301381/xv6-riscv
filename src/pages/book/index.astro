---
import { getCollection } from 'astro:content';
import BookFrame from '../../components/BookFrame.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { chapterPath } from '../../../scripts/lib/config.ts';
import { bookToc, splitBookChapter } from '../../../scripts/lib/book-sections.ts';

const chapters = (await getCollection('bookJa')).sort((a, b) => a.data.chapter - b.data.chapter);
const toc = bookToc(chapters.map(splitBookChapter));
---

<BaseLayout title="Book" description="公式 xv6 book の日本語版。" lang="ja" bookStyle>
  <BookFrame chapters={toc}>
    <div class="index-shell book-index">
    <header class="index-heading">
      <h1>The xv6 book</h1>
      <p>xv6 のしくみを章ごとに読む。</p>
    </header>

    <nav class="collection-links" aria-label="Book chapters">
      {chapters.map((chapter) => (
        <a class="collection-link" href={chapterPath(chapter.data.chapter)}>
          <span class="collection-link__number">{String(chapter.data.chapter).padStart(2, '0')}</span>
          <strong>{chapter.data.title}</strong>
        </a>
      ))}
    </nav>
    </div>
  </BookFrame>
</BaseLayout>
